{
  "name": "signature-read-error",
  "description": "R2 + §6.3: B calls X; A then changes X's signature. Because B's accepted edit already uses X, A's edit opens a stale_assumption on B's change (pushed, origin contract) and B's commit gate closes before B does anything else; B's next edit based before the change is rejected at check time (L2 deny) with stale_assumption; after draining (higher base) the same edit is accepted and clears it.",
  "covers": [
    "6.2 R2",
    "6.3",
    "5.2",
    "8.3",
    "8.4"
  ],
  "repo": "demo",
  "start": "2026-10-05T14:00:00.000Z",
  "steps": [
    {
      "op": "hello",
      "as": "A",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "claude-a",
          "harness": "claude-code"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-1"
        },
        "change": "I-a"
      },
      "expect": {
        "type": "welcome",
        "session": "s1",
        "head_seq": 1,
        "delivered_through": 1
      }
    },
    {
      "op": "hello",
      "as": "B",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "codex-b",
          "harness": "codex"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-2"
        },
        "change": "I-b"
      },
      "expect": {
        "type": "welcome",
        "session": "s2",
        "head_seq": 2,
        "delivered_through": 2
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 2,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 3
      }
    },
    {
      "op": "submit",
      "as": "A",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 1,
          "writes": [
            {
              "key": "src/auth/session.ts#refreshToken",
              "kind": "signature"
            }
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 4,
        "diagnostics": []
      }
    },
    {
      "op": "gate",
      "as": "B",
      "gate": "commit",
      "expect": {
        "allow": false,
        "open_errors": [
          {
            "code": "stale_assumption",
            "symbol": "src/auth/session.ts#refreshToken",
            "caused_by_seq": 4
          }
        ]
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "check",
        "event": {
          "kind": "edit",
          "base_seq": 3,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "verdict": "reject",
        "mode": "check",
        "seq": 5,
        "head_seq": 5,
        "diagnostics": [
          {
            "severity": "error",
            "code": "stale_assumption",
            "symbol": "src/auth/session.ts#refreshToken",
            "caused_by_seq": 4,
            "caused_by_agent": "claude-a",
            "caused_by_task": "T-1"
          }
        ],
        "inbox": [
          {
            "id": 1,
            "seq": 4,
            "kind": "diagnostic",
            "diagnostic": {
              "severity": "error",
              "code": "stale_assumption",
              "symbol": "src/auth/session.ts#refreshToken",
              "caused_by_seq": 4,
              "caused_by_agent": "claude-a"
            }
          }
        ],
        "context": "$any"
      }
    },
    {
      "op": "event",
      "seq": 5,
      "expect": {
        "status": "rejected",
        "mode": "check",
        "kind": "edit"
      }
    },
    {
      "op": "gate",
      "as": "B",
      "gate": "stop",
      "expect": {
        "allow": false,
        "open_errors": [
          {
            "code": "stale_assumption",
            "symbol": "src/auth/session.ts#refreshToken"
          }
        ]
      }
    },
    {
      "op": "drain",
      "as": "B",
      "ack": "last",
      "expect": {
        "items": [],
        "delivered_through": 5,
        "open_errors": {
          "$len": 1
        },
        "paused": false
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 5,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ],
          "reads": [
            "src/auth/session.ts#refreshToken"
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 6,
        "diagnostics": []
      }
    },
    {
      "op": "gate",
      "as": "B",
      "gate": "stop",
      "expect": {
        "allow": true
      }
    }
  ]
}
