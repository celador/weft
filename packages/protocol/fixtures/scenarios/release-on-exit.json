{
  "name": "release-on-exit",
  "description": "§7.5/§8.2: when a change's last live session ends (bye or expiry) its claims are released at once by a system release record; another live session of the same change keeps them.",
  "covers": [
    "7.5",
    "8.2"
  ],
  "repo": "demo",
  "start": "2026-10-05T14:00:00.000Z",
  "steps": [
    {
      "op": "hello",
      "as": "A",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "claude-a",
          "harness": "claude-code"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-1"
        },
        "change": "I-a"
      },
      "expect": {
        "type": "welcome",
        "session": "s1",
        "head_seq": 1,
        "delivered_through": 1
      }
    },
    {
      "op": "hello",
      "as": "B",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "codex-b",
          "harness": "codex"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-2"
        },
        "change": "I-b"
      },
      "expect": {
        "type": "welcome",
        "session": "s2",
        "head_seq": 2,
        "delivered_through": 2
      }
    },
    {
      "op": "submit",
      "as": "A",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 1,
          "writes": [
            {
              "key": "src/auth/session.ts#refreshToken",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "seq": 3
      }
    },
    {
      "op": "submit",
      "as": "A",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "claim",
          "base_seq": 3,
          "payload": {
            "firm": true,
            "source": "explicit"
          },
          "writes": [
            {
              "key": "src/auth/session.ts#SessionStore.get",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "seq": 4
      }
    },
    {
      "op": "hello",
      "as": "A2",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "claude-a",
          "harness": "claude-code"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-1"
        },
        "change": "I-a"
      },
      "expect": {
        "type": "welcome",
        "session": "s3",
        "head_seq": 5,
        "delivered_through": 5
      }
    },
    {
      "op": "bye",
      "as": "A"
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "check",
        "event": {
          "kind": "edit",
          "base_seq": 2,
          "writes": [
            {
              "key": "src/auth/session.ts#refreshToken",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": null,
        "diagnostics": [
          {
            "severity": "warning",
            "code": "claim_wait",
            "symbol": "src/auth/session.ts#refreshToken",
            "caused_by_seq": 3,
            "caused_by_agent": "claude-a"
          }
        ]
      }
    },
    {
      "op": "bye",
      "as": "A2"
    },
    {
      "op": "events",
      "after": 5,
      "expect": {
        "events": [
          {
            "seq": 6,
            "kind": "leave",
            "agent": "claude-a",
            "session": "s1"
          },
          {
            "seq": 7,
            "kind": "leave",
            "agent": "claude-a",
            "session": "s3"
          },
          {
            "seq": 8,
            "kind": "release",
            "status": "accepted",
            "actor": {
              "type": "system"
            },
            "agent": "claude-a",
            "change": "I-a",
            "payload": {
              "keys": [
                "src/auth/session.ts#refreshToken",
                "src/auth/session.ts#SessionStore.get"
              ],
              "reason": "session_ended"
            },
            "summary": "claude-a released refreshToken, SessionStore.get (session ended)"
          }
        ]
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "check",
        "event": {
          "kind": "edit",
          "base_seq": 2,
          "writes": [
            {
              "key": "src/auth/session.ts#refreshToken",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": null,
        "diagnostics": []
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 2,
          "writes": [
            {
              "key": "src/auth/session.ts#refreshToken",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 9
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "claim",
          "base_seq": 9,
          "payload": {
            "firm": true,
            "source": "explicit"
          },
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "seq": 10
      }
    },
    {
      "op": "advance",
      "ms": 400000
    },
    {
      "op": "tick",
      "expect": [
        {
          "seq": 11,
          "kind": "release",
          "status": "accepted",
          "actor": {
            "type": "system"
          },
          "agent": "codex-b",
          "change": "I-b",
          "payload": {
            "keys": [
              "src/auth/session.ts#refreshToken"
            ],
            "reason": "expired"
          }
        },
        {
          "seq": 12,
          "kind": "leave",
          "agent": "codex-b",
          "actor": {
            "type": "system"
          }
        },
        {
          "seq": 13,
          "kind": "release",
          "status": "accepted",
          "actor": {
            "type": "system"
          },
          "agent": "codex-b",
          "change": "I-b",
          "payload": {
            "keys": [
              "src/api/client.ts#fetchWithAuth"
            ],
            "reason": "session_expired"
          }
        }
      ]
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 10,
          "writes": [
            {
              "key": "src/api/client.ts#fetchWithAuth",
              "kind": "body"
            }
          ]
        }
      },
      "expect": {
        "type": "error",
        "error": {
          "code": "session_expired"
        }
      }
    }
  ]
}
