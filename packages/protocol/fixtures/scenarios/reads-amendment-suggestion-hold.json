{
  "name": "reads-amendment-suggestion-hold",
  "description": "§6.2 R2a under the default conflicts mode (hold): the contract_changed warning on a reads amendment, and the one pushed for a later signature change of an amended key, tell the agent to re-read the symbol and adapt its call sites (or negotiate).",
  "covers": [
    "6.2 R2a",
    "6.3",
    "8.4"
  ],
  "repo": "demo",
  "start": "2026-10-05T14:00:00.000Z",
  "steps": [
    {
      "op": "hello",
      "as": "A",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "claude-a",
          "harness": "claude-code"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-1"
        },
        "change": "I-a"
      },
      "expect": {
        "type": "welcome",
        "session": "s1",
        "head_seq": 1,
        "delivered_through": 1
      }
    },
    {
      "op": "hello",
      "as": "B",
      "hello": {
        "type": "hello",
        "protocol": "wcp/0.1",
        "agent": {
          "id": "codex-b",
          "harness": "codex"
        },
        "capabilities": {
          "level": 3,
          "observe": "sync",
          "inject": "immediate",
          "deny_edit": true,
          "refuse_stop": true,
          "commit_gate": "tool_interception"
        },
        "task": {
          "id": "T-2"
        },
        "change": "I-b"
      },
      "expect": {
        "type": "welcome",
        "session": "s2",
        "head_seq": 2,
        "delivered_through": 2
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 2,
          "writes": [
            {
              "key": "shop/cart.py#Cart.total",
              "kind": "body"
            }
          ],
          "reads": [
            "shop/__init__.py#calc_total"
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 3,
        "diagnostics": []
      }
    },
    {
      "op": "submit",
      "as": "A",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 1,
          "writes": [
            {
              "key": "shop/pricing.py#calc_total",
              "kind": "signature"
            }
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 4,
        "diagnostics": []
      }
    },
    {
      "op": "submit",
      "as": "B",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "intent",
          "base_seq": 3,
          "reads": [
            "shop/pricing.py#calc_total",
            "shop/pricing.py#Pricer.quote"
          ],
          "intent": "lsp reads amendment for #3"
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 5,
        "diagnostics": [
          {
            "severity": "warning",
            "code": "contract_changed",
            "symbol": "shop/pricing.py#calc_total",
            "caused_by_seq": 4,
            "caused_by_agent": "claude-a",
            "caused_by_task": "T-1",
            "file": "shop/pricing.py",
            "message": "claude-a changed the signature of shop/pricing.py#calc_total (#4) after your base #3, and your change uses it.",
            "suggestion": "Re-read shop/pricing.py#calc_total (event #4) and adapt your call sites, or negotiate with claude-a."
          }
        ]
      }
    },
    {
      "op": "gate",
      "as": "B",
      "gate": "stop",
      "expect": {
        "allow": true,
        "open_errors": []
      }
    },
    {
      "op": "drain",
      "as": "A",
      "ack": "last",
      "expect": {
        "items": [],
        "open_errors": []
      }
    },
    {
      "op": "submit",
      "as": "A",
      "submit": {
        "type": "submit",
        "mode": "commit",
        "event": {
          "kind": "edit",
          "base_seq": 5,
          "writes": [
            {
              "key": "shop/pricing.py#Pricer.quote",
              "kind": "signature"
            }
          ]
        }
      },
      "expect": {
        "verdict": "accept",
        "seq": 6,
        "diagnostics": []
      }
    },
    {
      "op": "drain",
      "as": "B",
      "ack": "last",
      "expect": {
        "items": [
          {
            "seq": 6,
            "kind": "diagnostic",
            "diagnostic": {
              "severity": "warning",
              "code": "contract_changed",
              "symbol": "shop/pricing.py#Pricer.quote",
              "caused_by_seq": 6,
              "caused_by_agent": "claude-a",
              "suggestion": "Re-read shop/pricing.py#Pricer.quote and adapt your call sites before your next edit, or negotiate (e.g. keep the old signature as an overload)."
            }
          }
        ],
        "open_errors": []
      }
    },
    {
      "op": "drain",
      "as": "A",
      "ack": "last",
      "expect": {
        "items": [],
        "open_errors": []
      }
    }
  ]
}
