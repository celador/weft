{
  "id": "RS.allow-unrelated",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Rust: an edit that does not use the changed function is not blocked",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/report.rs",
        "old_text": "    String::from(\"Total\")",
        "new_text": "    format!(\"Total: {}\", format_price(total))"
      },
      "expect_pre": {
        "decision": "not-deny"
      },
      "expect_applied": true
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "kind": "edit",
        "status": "accepted",
        "files_include": "src/report.rs",
        "min": 1
      }
    }
  ]
}
