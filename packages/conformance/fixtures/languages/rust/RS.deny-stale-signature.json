{
  "id": "RS.deny-stale-signature",
  "level": 2,
  "required": true,
  "spec": "§4.1, §5.2",
  "title": "Rust: a call built on a signature another agent just changed is denied before it runs",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/cart.rs",
        "old_text": "    format!(\"{} items\", items.len())",
        "new_text": "    format!(\"{} items, total {}\", items.len(), calc_total(items))"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "stale_assumption",
          "calc_total"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/cart.rs",
        "unchanged": true
      }
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "status": "rejected",
        "mode": "check",
        "reads_include": "src/pricing.rs#calc_total",
        "min": 1
      }
    }
  ]
}
