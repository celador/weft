{
  "id": "RS.deny-renamed",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Rust: a call to a function another agent renamed is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "rename_helper"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/report.rs",
        "old_text": "    String::from(\"Total\")",
        "new_text": "    format!(\"Total: {}\", format_price(total))"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "format_price"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/report.rs",
        "unchanged": true
      }
    }
  ]
}
