{
  "id": "RS.deny-module-path",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Rust: `pricing::calc_total(...)` through a module import is checked like a direct import",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
