{
  "id": "PHP.deny-renamed",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "PHP: a call (through a `use ... as` alias) to a method another agent renamed is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "rename_helper"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/Shop/Report.php",
        "old_text": "        return 'Total';",
        "new_text": "        return 'Total: ' . P::formatPrice($total);"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "formatPrice"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/Shop/Report.php",
        "unchanged": true
      }
    }
  ]
}
