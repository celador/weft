{
  "id": "PHP.allow-after-adapting",
  "level": 2,
  "required": true,
  "spec": "§5.2",
  "title": "PHP: after the deny, the call adapted to the new signature is allowed",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/Shop/Cart.php",
        "old_text": "        return count($items) . ' items';",
        "new_text": "        return count($items) . ' items, total ' . Pricing::calcTotal($items);"
      },
      "expect_pre": {
        "decision": "deny"
      }
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/Shop/Cart.php",
        "old_text": "        return count($items) . ' items';",
        "new_text": "        return count($items) . ' items, total ' . Pricing::calcTotal($items, 0.0);"
      },
      "expect_pre": {
        "decision": "not-deny"
      },
      "expect_applied": true
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "kind": "edit",
        "status": "accepted",
        "files_include": "src/Shop/Cart.php",
        "min": 1
      }
    }
  ]
}
