{
  "id": "GO.deny-renamed",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Go: a call to a function another agent renamed is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "rename_helper"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "report/report.go",
        "old_text": "\treturn \"Total\"",
        "new_text": "\treturn \"Total: \" + pricing.FormatPrice(total)"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "FormatPrice"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "report/report.go",
        "unchanged": true
      }
    }
  ]
}
