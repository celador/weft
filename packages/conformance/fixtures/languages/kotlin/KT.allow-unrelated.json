{
  "id": "KT.allow-unrelated",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Kotlin: an edit that does not use the changed function is not blocked",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/main/kotlin/com/shop/report/Report.kt",
        "old_text": "    return \"Total\"",
        "new_text": "    return \"Total: \" + formatPrice(total)"
      },
      "expect_pre": {
        "decision": "not-deny"
      },
      "expect_applied": true
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "kind": "edit",
        "status": "accepted",
        "files_include": "src/main/kotlin/com/shop/report/Report.kt",
        "min": 1
      }
    }
  ]
}
