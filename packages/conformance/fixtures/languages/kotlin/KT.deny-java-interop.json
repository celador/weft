{
  "id": "KT.deny-java-interop",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Kotlin calling Java: a call to a Java method another agent just changed is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "java_tax_by_region"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/main/kotlin/com/shop/checkout/Checkout.kt",
        "old_text": "        return 0.0",
        "new_text": "        return net * Tax.rate()"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "stale_assumption",
          "Tax.rate"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "status": "rejected",
        "mode": "check",
        "reads_include": "src/main/java/com/shop/model/Tax.java#Tax.rate",
        "min": 1
      }
    }
  ]
}
