{
  "id": "KT.deny-same-package",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Kotlin: a same-package call (no import) to a function another file declares, which another agent just changed, is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/main/kotlin/com/shop/pricing/Discounts.kt",
        "old_text": "    return 0.0",
        "new_text": "    return calcTotal(items) * 0.9"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "stale_assumption",
          "calcTotal"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/main/kotlin/com/shop/pricing/Discounts.kt",
        "unchanged": true
      }
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "status": "rejected",
        "mode": "check",
        "reads_include": "src/main/kotlin/com/shop/pricing/Pricing.kt#calcTotal",
        "min": 1
      }
    }
  ]
}
