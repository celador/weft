{
  "id": "KT.deny-renamed",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Kotlin: a call to a top-level function another agent renamed is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "rename_helper"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/main/kotlin/com/shop/report/Report.kt",
        "old_text": "    return \"Total\"",
        "new_text": "    return \"Total: \" + formatPrice(total)"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "formatPrice"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/main/kotlin/com/shop/report/Report.kt",
        "unchanged": true
      }
    }
  ]
}
