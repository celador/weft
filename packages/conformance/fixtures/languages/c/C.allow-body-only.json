{
  "id": "C.allow-body-only",
  "level": 2,
  "required": true,
  "spec": "\u00a74.1",
  "title": "C: a body-only change in the .c (same header key, kind body) does not block callers of the header",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_body"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/cart.c",
        "old_text": "  return n;",
        "new_text": "  return calc_total(items, n);"
      },
      "expect_pre": {
        "decision": "not-deny"
      },
      "expect_applied": true
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "kind": "edit",
        "status": "accepted",
        "files_include": "src/cart.c",
        "min": 1
      }
    }
  ]
}
