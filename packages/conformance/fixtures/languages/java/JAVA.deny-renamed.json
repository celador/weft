{
  "id": "JAVA.deny-renamed",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Java: a call to a static method another agent renamed (static import) is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "rename_helper"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/main/java/com/shop/report/Report.java",
        "old_text": "        return \"Total\";",
        "new_text": "        return \"Total: \" + formatPrice(total);"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "formatPrice"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/main/java/com/shop/report/Report.java",
        "unchanged": true
      }
    }
  ]
}
