{
  "id": "JAVA.deny-stale-signature",
  "level": 2,
  "required": true,
  "spec": "§4.1, §5.2",
  "title": "Java: a call built on a signature another agent just changed is denied before it runs",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/main/java/com/shop/cart/CartSummary.java",
        "old_text": "        return items.size() + \" items\";",
        "new_text": "        return items.size() + \" items, total \" + Pricing.calcTotal(items);"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "stale_assumption",
          "calcTotal"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/main/java/com/shop/cart/CartSummary.java",
        "unchanged": true
      }
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "status": "rejected",
        "mode": "check",
        "reads_include": "src/main/java/com/shop/pricing/Pricing.java#Pricing.calcTotal",
        "min": 1
      }
    }
  ]
}
