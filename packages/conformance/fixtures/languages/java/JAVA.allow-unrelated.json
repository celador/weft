{
  "id": "JAVA.allow-unrelated",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Java: an edit that uses another method of the changed class is not blocked",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/main/java/com/shop/report/Report.java",
        "old_text": "        return \"Total\";",
        "new_text": "        return \"Total: \" + formatPrice(total);"
      },
      "expect_pre": {
        "decision": "not-deny"
      },
      "expect_applied": true
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "kind": "edit",
        "status": "accepted",
        "files_include": "src/main/java/com/shop/report/Report.java",
        "min": 1
      }
    }
  ]
}
