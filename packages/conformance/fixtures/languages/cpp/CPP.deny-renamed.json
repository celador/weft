{
  "id": "CPP.deny-renamed",
  "level": 2,
  "required": true,
  "spec": "\u00a74.1",
  "title": "C++: a qualified call to a function another agent renamed is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "rename_helper"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "src/receipt.cpp",
        "old_text": "  return \"Total\";",
        "new_text": "  return \"Total: \" + shop::format_price(total);"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "format_price"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "src/receipt.cpp",
        "unchanged": true
      }
    }
  ]
}
