{
  "id": "RB.allow-unrelated",
  "level": 2,
  "required": true,
  "spec": "§4.1",
  "title": "Ruby: an edit that does not use the changed method is not blocked",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "lib/report.rb",
        "old_text": "    \"Total\"",
        "new_text": "    \"Total: \" + Pricing.format_price(total)"
      },
      "expect_pre": {
        "decision": "not-deny"
      },
      "expect_applied": true
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "kind": "edit",
        "status": "accepted",
        "files_include": "lib/report.rb",
        "min": 1
      }
    }
  ]
}
