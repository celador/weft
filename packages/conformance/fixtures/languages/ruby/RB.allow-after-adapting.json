{
  "id": "RB.allow-after-adapting",
  "level": 2,
  "required": true,
  "spec": "§5.2",
  "title": "Ruby: after the deny, the call adapted to the new signature is allowed",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "lib/cart.rb",
        "old_text": "    \"#{items.size} items\"",
        "new_text": "    \"#{items.size} items, total #{Pricing.calc_total(items)}\""
      },
      "expect_pre": {
        "decision": "deny"
      }
    },
    {
      "tool": {
        "kind": "edit",
        "path": "lib/cart.rb",
        "old_text": "    \"#{items.size} items\"",
        "new_text": "    \"#{items.size} items, total #{Pricing.calc_total(items, tax_rate: 0.0)}\""
      },
      "expect_pre": {
        "decision": "not-deny"
      },
      "expect_applied": true
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "kind": "edit",
        "status": "accepted",
        "files_include": "lib/cart.rb",
        "min": 1
      }
    }
  ]
}
