{
  "id": "PY.deny-renamed",
  "level": 2,
  "required": true,
  "spec": "\u00a74.1",
  "title": "Python: a call to a function another agent renamed (relative import) is denied",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "rename_helper"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "app/report.py",
        "old_text": "    return \"Total\"",
        "new_text": "    return \"Total: \" + format_price(total)"
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "format_price"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "app/report.py",
        "unchanged": true
      }
    }
  ]
}
