{
  "id": "PY.deny-stale-signature",
  "level": 2,
  "required": true,
  "spec": "\u00a74.1, \u00a75.2",
  "title": "Python: a call built on a signature another agent just changed is denied before it runs",
  "steps": [
    {
      "event": "session.start"
    },
    {
      "peer": "change_signature"
    },
    {
      "tool": {
        "kind": "edit",
        "path": "app/cart.py",
        "old_text": "    return f\"{len(items)} items\"",
        "new_text": "    return f\"{len(items)} items, total {calc_total(items)}\""
      },
      "expect_pre": {
        "decision": "deny",
        "explanation": [
          "stale_assumption",
          "calc_total"
        ]
      },
      "expect_applied": false
    },
    {
      "expect_file": {
        "path": "app/cart.py",
        "unchanged": true
      }
    },
    {
      "expect_log": {
        "agent": "$SELF",
        "status": "rejected",
        "mode": "check",
        "reads_include": "app/pricing.py#calc_total",
        "min": 1
      }
    }
  ]
}
