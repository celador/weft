{
  "name": "@weft/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run && vitest run --config vitest.billing.config.ts",
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --env test",
    "deploy:preview": "wrangler deploy --env preview",
    "deploy:hosted": "wrangler deploy --env hosted",
    "test:billing": "vitest run --config vitest.billing.config.ts"
  },
  "dependencies": {
    "@weft/artifacts": "workspace:*",
    "@weft/protocol": "workspace:*",
    "@weft/sequencer": "workspace:*",
    "@weft/workflows": "workspace:*"
  }
}
