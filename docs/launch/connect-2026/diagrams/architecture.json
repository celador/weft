 "cards": [
  {
   "dot": "rose",
   "title": "Edit time",
   "items": [
    "Hooks check every edit before it is written (PreToolUse deny = squiggle)",
    "One Durable Object per repo orders every event; the log replays byte for byte"
   ]
  },
  {
   "dot": "emerald",
   "title": "Land time",
   "items": [
    "Every push is rebased (git, then Mergiraf, then a resolver agent) and gets evidence",
    "Trunk moves only by compare-and-swap: a lost race is stale_trunk and retries"
   ]
  },
  {
   "dot": "amber",
   "title": "Scope",
   "items": [
    "Live: Claude Code, Codex, OpenCode, Gemini CLI, Hermes, file watcher",
